# Copie este arquivo para .env e preencha os valores.
PORT=3000
NODE_ENV=production

# Crie uma senha forte e exclusiva para entrar em /admin.html
ADMIN_PASSWORD=COLOQUE_UMA_SENHA_FORTE_AQUI

# WhatsApp do proprietário com código do país + DDD + número, somente números.
# Exemplo de formato: 5511999999999
OWNER_WHATSAPP=

# Usuário do Instagram, sem @.
OWNER_INSTAGRAM=
